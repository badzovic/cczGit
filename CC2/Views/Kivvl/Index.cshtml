@model CC2.Models.Pregled

@{
    ViewBag.Title = "Pregled KI VVL kontakata";
}
<link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest"></script>

<main class="main-content position-relative border-radius-lg ">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header pb-0">
                        <h5 class="mb-0">KI VVL kontakti</h5>
                        <p class="text-sm mb-0">Sortirano po zadnjem ažuriranju.</p>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-flush" id="datatable-vvl">
                            <thead class="thead-light">
                                <tr style="text-align:center;">
                                    <th>Broj</th>
                                    <th>Firma</th>
                                    <th>Broj kartica</th>
                                    <th>Adresa</th>
                                    <th>PLZ</th>
                                    <th>Telefon</th>
                                    <th>VVL datum</th>
                                    <th>Pregledaj</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.kontaktiSales != null && Model.kontaktiSales.Any())
                                {
                                    int rb = 1;
                                    foreach (var item in Model.kontaktiSales)
                                    {
                                        <tr>
                                            <td>@item.Kontakt.ID</td>
                                            <td>@item.Kontakt.FIRMA</td>
                                            <td>@item.Kontakt.BROJ_KARTICA</td>
                                            <td>@item.Kontakt.ADRESA</td>
                                            <td>@item.Kontakt.PLZ</td>
                                            <td>@item.Kontakt.PREFIX @item.Kontakt.BROJ</td>
                                            <td>
                                                @(item.Kontakt.VVL_DATUM.HasValue
                                                    ? item.Kontakt.VVL_DATUM.Value.ToString("dd.MM.yyyy")
                                                    : "-")
                                            </td>
                                            <td>
                                                <a class="btn btn-outline-primary btn-sm"
                                                   href="@Url.Action("kontaktSales", "Pregled", new { id = item.Kontakt.ID })">
                                                    Otvori
                                                </a>
                                            </td>
                                        </tr>
                                        rb++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">Nema KI VVL kontakata.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const dataTable = new simpleDatatables.DataTable("#datatable-vvl", {
            searchable: true,
            fixedHeight: true,
            perPageSelect: [10, 25, 50],
            labels: {
                placeholder: "Pretraži...",
                perPage: "Redova po stranici",
                noRows: "Nema podataka",
                info: "Prikazano {start} - {end} od {rows}"
            }
        });
    });
</script>
